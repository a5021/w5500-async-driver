# libFuzzer dictionary for the W5500 harnesses: SPI control-byte encodings,
# register addresses (big-endian address phase), Sn_CR commands, Sn_IR bits,
# buffer sizes and protocol magic. Tokens are byte strings shared by every
# harness; each harness interprets positions on its own.
# --- SPI control bytes (BSB << 3 | RWB << 2 | OM=VDM=0) ---
ctrl_common_write="\x00"
ctrl_common_read="\x04"
ctrl_sreg0_write="\x08"
ctrl_sreg0_read="\x0c"
ctrl_txbuf0_write="\x10"
ctrl_txbuf0_read="\x14"
ctrl_rxbuf0_write="\x18"
ctrl_rxbuf0_read="\x1c"
ctrl_sreg1_write="\x28"
ctrl_sreg1_read="\x2c"
ctrl_sreg2_write="\x48"
ctrl_sreg2_read="\x4c"
ctrl_sreg3_write="\x68"
ctrl_sreg3_read="\x6c"
# --- register addresses (address phase, big endian) ---
addr_mr="\x00\x00"
addr_gar="\x00\x01"
addr_subr="\x00\x05"
addr_shar="\x00\x09"
addr_sipr="\x00\x0f"
addr_rtr="\x00\x19"
addr_phycfgr="\x00\x2e"
addr_versionr="\x00\x39"
addr_sn_cr="\x00\x01"
addr_sn_ir="\x00\x02"
addr_sn_sr="\x00\x03"
addr_sn_port="\x00\x04"
addr_sn_rxbuf="\x00\x1e"
addr_sn_txbuf="\x00\x1f"
addr_tx_fsr="\x00\x20"
addr_rx_rsr="\x00\x26"
# --- Sn_CR commands ---
cmd_open="\x01"
cmd_listen="\x02"
cmd_connect="\x04"
cmd_discon="\x08"
cmd_close="\x10"
cmd_send="\x20"
cmd_recv="\x40"
# --- Sn_IR bits (also natural high-argument tokens) ---
ir_con="\x01"
ir_discon="\x02"
ir_recv="\x04"
ir_timeout="\x08"
ir_sendok="\x10"
# --- mode / magic values ---
mr_rst="\x80"
version_r="\x04"
phy_link_up="\x01"
proto_tcp="\x01"
proto_udp="\x02"
buf_1k="\x01"
buf_2k="\x02"
buf_4k="\x04"
buf_8k="\x08"
buf_16k="\x10"
# --- common shapes: local IP and locally administered MAC ---
ip_lan="\xc0\xa8\x01\x0a"
mac_local="\x02\x00\x00\x00\x00\x01"
port_8080="\x1f\x90"
